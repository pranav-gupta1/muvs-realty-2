# ═══════════════════════════════════════════════════════════════════════════
#  MUVS Realty — environment
#  Copy to `.env` and fill in. Everything needed to run the FULL app locally
#  (including phone verification) already has a working default below.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
# SQLite for local dev. To move to Postgres, change the datasource provider in
# prisma/schema.prisma to "postgresql" and put the connection string here.
#   postgresql://user:password@host:5432/muvs?schema=public
DATABASE_URL="file:./dev.db"

# ── Site ───────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap.xml, robots.txt, OG images and
# the admin links inside internal lead emails. Keep the production domain here
# even in dev so generated canonicals are correct.
NEXT_PUBLIC_SITE_URL="https://www.muvsrealty.com"

# ── Admin auth (next-auth Credentials provider) ────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# Where next-auth thinks it is running. Local dev only; unset on Vercel.
AUTH_URL="http://localhost:3000"

# Seeded admin account (`npm run db:seed`). CHANGE THE PASSWORD before deploying.
ADMIN_EMAIL="admin@muvsrealty.com"
ADMIN_PASSWORD="muvs@admin123"
ADMIN_NAME="MUVS Admin"

# ── Phone verification (OTP) ───────────────────────────────────────────────
# Codes are generated and checked by this app; the provider below only delivers
# the SMS. See "Phone verification" in README.md for the full rationale.
#
# SMS_PROVIDER:
#   console  — no account needed. Prints the code to the server log. DEFAULT.
#   msg91    — MSG91 (India; DLT-registered senders). Recommended for India.
#   twilio   — Twilio Programmable SMS. Best for international/NRI traffic.
SMS_PROVIDER="console"

# Keys the OTP hash. Codes are stored only as HMAC-SHA256 digests, so rotating
# this value immediately invalidates every outstanding code.
# Generate with: openssl rand -hex 32
OTP_HASH_SECRET="replace-me-with-openssl-rand-hex-32"

# DEV MODE — when true, the OTP is always OTP_DEV_CODE, it is shown on screen
# and logged, and no SMS is sent regardless of SMS_PROVIDER. MUST be false in
# production; the app refuses to start with this on when NODE_ENV=production.
OTP_DEV_MODE="true"
OTP_DEV_CODE="123456"

# MSG91 (only when SMS_PROVIDER=msg91). Validate with `npm run check:sms`.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Twilio (only when SMS_PROVIDER=twilio). Validate with `npm run check:sms`.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sending number in E.164, e.g. +15551234567 (or a Messaging Service SID below).
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# ── Email (Nodemailer / SMTP) ──────────────────────────────────────────────
# If SMTP_HOST is empty, emails are pretty-printed to the server console
# instead of being sent — the app never crashes or fails a lead over email.
# Google Workspace: smtp.gmail.com : 465 (secure) with an App Password.
# Zoho:             smtp.zoho.in   : 465 (secure).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Envelope From. Must be a mailbox the SMTP account is allowed to send as.
SMTP_FROM="MUVS Realty <info@muvsrealty.com>"
# Internal inbox that receives every lead notification.
LEADS_INBOX="info@muvsrealty.com"

# ── Uploads ────────────────────────────────────────────────────────────────
# local — writes to /public/uploads (dev default; NOT viable on serverless).
# Swap for S3/Cloudinary by adding an adapter in src/lib/storage.ts.
UPLOAD_DRIVER="local"
UPLOAD_MAX_MB="8"
